# Copy this file to `.env` (which is gitignored) and fill in real values.
# docker-compose reads `.env` automatically. Nothing in here is committed.

# ── JWT signing secret ────────────────────────────────────────────────────────
# Signs and validates every login token. api-gateway issues tokens with it and
# stats-service validates them, so BOTH services must use the SAME value.
#
# There is intentionally no default anywhere in the code: the services refuse to
# start without this, so nothing can silently run on a known-public key. The old
# committed default was exposed in this public repo and must not be reused.
#
# Generate a strong one (32+ random bytes), e.g.:
#   openssl rand -base64 48
#
# Rotating this value invalidates every existing session — users just log in again.
JWT_SECRET=

# ── Existing optional vars (shown for completeness) ───────────────────────────
# Email (Resend). Leave blank in local dev to avoid sending real mail.
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=OBHL <onboarding@resend.dev>
# FRONTEND_URL=http://localhost:5173
